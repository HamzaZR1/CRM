# --- Database (libSQL). Local SQLite file by default; use a Turso URL + token in the cloud.
DATABASE_URL=file:./data/zcrm.db
# DATABASE_AUTH_TOKEN=

# --- Auth: long random string used to sign session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Public URL of this install (used to build webhook URLs shown in Integrations)
APP_URL=http://localhost:3000

# --- AI agent (Claude). Without a key ZCRM falls back to its built-in rule-based agent.
# ANTHROPIC_API_KEY=
# ZCRM_AI_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (Meta). Without these, messages go to the built-in simulator.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=zcrm-verify
# WHATSAPP_APP_SECRET=

# --- Optional speech-to-text for customer voice notes (any Whisper-compatible HTTP endpoint
# that accepts multipart "file" and returns {"text": "..."}).
# ZCRM_STT_URL=
# ZCRM_STT_TOKEN=

# --- Protects /api/cron/tick when called by an external scheduler
CRON_SECRET=change-me
